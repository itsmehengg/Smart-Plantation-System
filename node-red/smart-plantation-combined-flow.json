  {
    "id": "a4e9fb9c4d541c9d",
    "type": "function",
    "z": "d6a9f1430c2f0c18",
    "name": "Format sensor table",
    "func": "const p = msg.payload || {};\nconst waterLevel = p.water_level ?? p.waterLevel ?? p.water ?? null;\nconst waterStatus = p.water_level_status ?? p.waterLevelStatus ?? (Number(waterLevel) >= 80 ? 'full' : 'not full');\n\nconst rows = [\n    { sensor: 'Temperature', value: p.temperature ?? p.temp ?? null, unit: 'C' },\n    { sensor: 'Humidity', value: p.humidity ?? p.hum ?? null, unit: '%' },\n    { sensor: 'Soil Moisture', value: p.soil_moisture ?? p.soilMoisture ?? p.soil ?? null, unit: '%' },\n    { sensor: 'Soil Digital', value: p.soil_digital ?? p.soilDigital ?? null, unit: '0/1' },\n    { sensor: 'Water Level', value: waterStatus, unit: '' },\n    { sensor: 'Water Level Percent', value: waterLevel, unit: '%' },\n    { sensor: 'Water Distance', value: p.water_distance_cm ?? null, unit: 'cm' },\n    { sensor: 'Soil Raw', value: p.soil_raw ?? null, unit: 'ADC' }\n];\n\nmsg.payload = rows.map(row => ({\n    sensor: row.sensor,\n    value: row.value === null || row.value === undefined ? '-' : row.value,\n    unit: row.unit,\n    updated: new Date().toLocaleString()\n}));\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 590,
    "y": 260,
    "wires": [
      [
        "ace2e8e4e4e54c20"
      ]
    ]
  },
  {
    "id": "ace2e8e4e4e54c20",
    "type": "ui_template",
    "z": "d6a9f1430c2f0c18",
    "group": "a424ba52f9158af1",
    "name": "Sensor table",
    "order": 6,
    "width": 12,
    "height": 4,
    "format": "<table style=\"width:100%; border-collapse:collapse; font-size:14px;\">\n  <thead>\n    <tr style=\"border-bottom:1px solid #ddd;\">\n      <th style=\"text-align:left; padding:6px;\">Sensor</th>\n      <th style=\"text-align:right; padding:6px;\">Value</th>\n      <th style=\"text-align:left; padding:6px;\">Unit</th>\n      <th style=\"text-align:left; padding:6px;\">Updated</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr ng-repeat=\"row in msg.payload\" style=\"border-bottom:1px solid #eee;\">\n      <td style=\"padding:6px;\">{{row.sensor}}</td>\n      <td style=\"padding:6px; text-align:right; font-weight:600;\">{{row.value}}</td>\n      <td style=\"padding:6px;\">{{row.unit}}</td>\n      <td style=\"padding:6px;\">{{row.updated}}</td>\n    </tr>\n  </tbody>\n</table>",
    "storeOutMessages": true,
    "fwdInMessages": true,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
