    "type": "function",
    "z": "d6a9f1430c2f0c18",
    "name": "Check Supabase upload",
    "func": "if (msg.statusCode >= 200 && msg.statusCode < 300) {\n    node.status({ fill: 'green', shape: 'dot', text: `inserted ${new Date().toLocaleTimeString()}` });\n} else {\n    node.status({ fill: 'red', shape: 'ring', text: `failed ${msg.statusCode}` });\n}\nreturn msg;",
