  {
    "id": "automatic_fan_control",
    "type": "function",
    "z": "d6a9f1430c2f0c18",
    "name": "Automatic temperature fan",
    "func": "const HIGH = 30;\nconst LOW = 29;\n\nconst mode = flow.get('fanMode') || 'AUTO';\nif (mode !== 'AUTO') {\n    // ESP32 is in a manual override state; let the button nodes drive it instead.\n    return null;\n}\n\nconst temp = typeof msg.payload === 'number'\n    ? msg.payload\n    : Number(msg.payload?.temperature ?? msg.payload?.temp);\nif (!Number.isFinite(temp)) {\n    return null;\n}\n\nlet fanOn = flow.get('fanState');\nif (fanOn === undefined) fanOn = false;\n\nlet cmd = null;\nif (temp >= HIGH && !fanOn) {\n    cmd = 'ON';\n    flow.set('fanState', true);\n} else if (temp <= LOW && fanOn) {\n    cmd = 'OFF';\n    flow.set('fanState', false);\n}\n\nif (cmd === null) return null;\nnode.status({ fill: cmd === 'ON' ? 'green' : 'grey', shape: 'dot', text: cmd + ' @ ' + temp.toFixed(1) + '\\u00b0C' });\nreturn { topic: 'smartplantation/control/fan', payload: cmd };",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 600,
    "y": 190,
    "wires": [
      [
        "relay_command_mqtt_out"
      ]
    ]
  },
  {
    "id": "automatic_pump_control",
    "type": "function",
    "z": "d6a9f1430c2f0c18",
    "name": "Automatic soil moisture pump",
    "func": "const payload = msg.payload || {};\nconst soilMoisture = Number(\n    payload.soil_moisture ?? payload.soilMoisture ?? payload.soil\n);\n\nconst PUMP_ON_BELOW = 80;\nconst PUMP_OFF_AT = 80;\n\nif (!Number.isFinite(soilMoisture) || soilMoisture < 0 || soilMoisture > 100) {\n    node.warn('Invalid soil moisture value; automatic pump control skipped.');\n    return null;\n}\n\nlet pumpState = context.get('pumpState') || 'OFF';\nlet nextState = null;\n\nif (soilMoisture < PUMP_ON_BELOW && pumpState !== 'ON') {\n    nextState = 'ON';\n} else if (soilMoisture >= PUMP_OFF_AT && pumpState !== 'OFF') {\n    nextState = 'OFF';\n}\n\nif (!nextState) {\n    return null;\n}\n\ncontext.set('pumpState', nextState);\n\nnode.status({\n    fill: nextState === 'ON' ? 'red' : 'green',\n    shape: 'dot',\n    text: `Pump ${nextState} at ${soilMoisture}%`\n});\n\nreturn {\n    topic: 'smartplantation/control/pump',\n    payload: nextState,\n    relay: 'IN2',\n    soil_moisture: soilMoisture,\n    automatic: true\n};",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 600,
    "y": 150,
    "wires": [
      [
        "relay_command_mqtt_out"
      ]
    ]
  },
  {
    "id": "b4a3d31a7c2f4b0a",
    "type": "function",
    "z": "d6a9f1430c2f0c18",
    "name": "Split sensor values",
    "func": "const p = msg.payload || {};\n\nfunction value(...names) {\n    for (const name of names) {\n        if (p[name] !== undefined && p[name] !== null) return Number(p[name]);\n    }\n    return null;\n}\n\nconst temperature = value('temperature', 'temp');\nconst humidity = value('humidity', 'hum');\nconst soil = value('soil_moisture', 'soilMoisture', 'soil');\nconst water = value('water_level', 'waterLevel', 'water');\n\nreturn [\n    temperature === null ? null : { payload: temperature, topic: 'Temperature' },\n    humidity === null ? null : { payload: humidity, topic: 'Humidity' },\n    soil === null ? null : { payload: soil, topic: 'Soil Moisture' },\n    water === null ? null : { payload: water, topic: 'Water Level' }\n];",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 560,
    "y": 100,
