  {
    "id": "ef33a77550b2fe63",
    "type": "function",
    "z": "d6a9f1430c2f0c18",
    "name": "Auto prepare Supabase insert",
    "func": "let p = msg.payload || {};\n\nif (typeof p === 'string') {\n    try {\n        p = JSON.parse(p);\n    } catch (error) {\n        node.warn('Sensor payload is not valid JSON. Supabase upload skipped.');\n        return null;\n    }\n}\n\nfunction numberOrNull(value) {\n    if (value === undefined || value === null || value === '') return null;\n    const number = Number(value);\n    return Number.isFinite(number) ? number : null;\n}\n\nconst waterLevel = numberOrNull(p.water_level ?? p.waterLevel ?? p.water);\nconst waterStatus = p.water_level_status ?? p.waterLevelStatus ?? (waterLevel >= 80 ? 'full' : 'not full');\n\nmsg.headers = {\n    apikey: 'sb_publishable_7Kgk2nj4WLTAuX86ucXDKw_CQ3J18lh',\n    Authorization: 'Bearer sb_publishable_7Kgk2nj4WLTAuX86ucXDKw_CQ3J18lh',\n    'Content-Type': 'application/json',\n    Prefer: 'return=representation'\n};\n\nmsg.payload = {\n    temperature: numberOrNull(p.temperature ?? p.temp),\n    humidity: numberOrNull(p.humidity ?? p.hum),\n    soil_moisture: numberOrNull(p.soil_moisture ?? p.soilMoisture ?? p.soil),\n    soil_digital: numberOrNull(p.soil_digital ?? p.soilDigital),\n    water_level: waterLevel,\n    water_level_status: waterStatus,\n    water_distance_cm: numberOrNull(p.water_distance_cm),\n    soil_raw: numberOrNull(p.soil_raw)\n};\n\nnode.status({ fill: 'blue', shape: 'dot', text: 'uploading to Supabase' });\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 600,
    "y": 320,
    "wires": [
      [
        "aa17c00a31163e95"
      ]
    ]
  },
